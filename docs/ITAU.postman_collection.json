          "name": "5.1 E-mail duplicado em outra caixa → 422",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422', () => pm.response.to.have.status(422));",
                  "pm.test('duplicidade detectada após normalização', () => pm.expect(pm.response.json().mensagem).to.include('Ja existe chave PIX cadastrada'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
