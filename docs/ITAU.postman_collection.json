              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/pix-keys",
            "description": "Mesmo e-mail do 1.2 em caixa alta: a unicidade é comparada sobre o valor canônico."
          }
        },
        {
