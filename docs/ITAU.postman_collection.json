                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"tipoConta\": \"corrente\",\n    \"numeroAgencia\": \"1234\",\n    \"numeroConta\": \"12345678\",\n    \"nomeCorrentista\": \"Maria\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/pix-keys/{{id}}"
          }
        },
        {
          "name": "4.5 Reincluir o valor de uma chave inativa → 422",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422', () => pm.response.to.have.status(422));",
                  "pm.test('unicidade definitiva', () => pm.expect(pm.response.json().mensagem).to.include('Ja existe chave PIX cadastrada'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"tipoChave\": \"celular\",\n    \"valorChave\": \"{{celular}}\",\n    \"tipoConta\": \"corrente\",\n    \"numeroAgencia\": \"1234\",\n    \"numeroConta\": \"12345678\",\n    \"nomeCorrentista\": \"Maria\"\n}",
              "options": { "raw": { "language": "json" } }
            },
