              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/pix-keys"
          }
        },
        {
          "name": "5.7 Tipo de chave não implementado → 422",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
